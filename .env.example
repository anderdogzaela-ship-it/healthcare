# Copy to .env.local and fill in with values from your Supabase project
# (Supabase dashboard → Project Settings → API).
# .env.local is git-ignored. Never commit real keys.

# Safe to expose in the browser: the anon key only works together with RLS.
# The Vercel–Supabase integration injects SUPABASE_URL and SUPABASE_ANON_KEY
# instead, and the app accepts either spelling.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for links in confirmation and password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only: powers the AI health assistant (console.anthropic.com).
# Never prefix this with NEXT_PUBLIC_, or it would ship to the browser.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5. claude-sonnet-5 or claude-haiku-4-5
# cost less per answer, which stretches demo credits.
ANTHROPIC_MODEL=

# Alternative: run Claude on Amazon Bedrock, paid from AWS credits.
# Set AI_PROVIDER=bedrock, then EITHER a Bedrock API key OR an IAM key pair.
# Not the AWS_* names: Vercel reserves those. See SETUP.md.
AI_PROVIDER=
BEDROCK_REGION=us-east-1
BEDROCK_API_KEY=
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# Automation (n8n, Zapier, Make). Both are server-side only.
# The service role key bypasses row level security: it is used exclusively by
# the /api/automation routes, which act for the scheduler, not for a user.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Shared secret the scheduler sends as the x-api-key header. At least 24
# characters: generate with `openssl rand -hex 32`.
AUTOMATION_API_KEY=

# Set automatically by Vercel Cron; also accepted on the retry endpoint so the
# job can be triggered manually. Optional outside Vercel.
CRON_SECRET=

# Billing (optional: the app runs without it, subscriptions simply stay off).
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in production.
STRIPE_WEBHOOK_SECRET=whsec_...
# Recurring price ids created in the Stripe dashboard.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_CLINIC=price_...
