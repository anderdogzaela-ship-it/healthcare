{
  "name": "HealthAI — Appointment reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "1a000000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-640, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1a000000-0000-4000-8000-0000000000a1",
              "name": "baseUrl",
              "value": "https://healthcare-beta-lemon.vercel.app",
              "type": "string"
            },
            {
              "id": "1a000000-0000-4000-8000-0000000000a2",
              "name": "twilioAccountSid",
              "value": "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
              "type": "string"
            },
            {
              "id": "1a000000-0000-4000-8000-0000000000a3",
              "name": "whatsappFrom",
              "value": "whatsapp:+14155238886",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000007",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-420, 0],
      "notes": "Edit these three values. Keys do not go here: they live in the two credentials."
    },
    {
      "parameters": {
        "url": "={{ $('Settings').first().json.baseUrl }}/api/automation/reminders/due?limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000002",
      "name": "Get due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "fieldToSplitOut": "reminders",
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000003",
      "name": "One item per reminder",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [20, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.twilio.com/2010-04-01/Accounts/{{ $('Settings').first().json.twilioAccountSid }}/Messages.json",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBasicAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "From",
              "value": "={{ $('Settings').first().json.whatsappFrom }}"
            },
            {
              "name": "To",
              "value": "=whatsapp:{{ $json.phone }}"
            },
            {
              "name": "Body",
              "value": "={{ $json.message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000004",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.baseUrl }}/api/automation/reminders/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $('One item per reminder').item.json.jobId, status: 'sent', channel: 'whatsapp', providerMessageId: $json.sid }) }}",
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000005",
      "name": "Mark as sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').first().json.baseUrl }}/api/automation/reminders/complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ jobId: $('One item per reminder').item.json.jobId, status: 'failed', channel: 'whatsapp', error: String($json.error?.message || $json.error || 'send failed').slice(0, 500) }) }}",
        "options": {}
      },
      "id": "1a000000-0000-4000-8000-000000000006",
      "name": "Mark as failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 120]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [[{ "node": "Settings", "type": "main", "index": 0 }]]
    },
    "Settings": {
      "main": [[{ "node": "Get due reminders", "type": "main", "index": 0 }]]
    },
    "Get due reminders": {
      "main": [[{ "node": "One item per reminder", "type": "main", "index": 0 }]]
    },
    "One item per reminder": {
      "main": [[{ "node": "Send WhatsApp", "type": "main", "index": 0 }]]
    },
    "Send WhatsApp": {
      "main": [
        [{ "node": "Mark as sent", "type": "main", "index": 0 }],
        [{ "node": "Mark as failed", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
